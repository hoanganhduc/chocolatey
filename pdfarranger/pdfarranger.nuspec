<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pdfarranger</id>
    <title>pdfarranger</title>
    <version>1.14.0</version>
    <authors>PDF-Arranger developer team</authors>
    <owners>hoanganhduc</owners>
    <summary>pdfarranger for Windows</summary>
    <description>pdfarranger is a small Python/GTK application for merging or splitting PDF documents and rotating, cropping, and rearranging their pages using an interactive graphical interface. It is a frontend for pikepdf and a fork of pdfshuffler.</description>
    <projectUrl>https://github.com/pdfarranger/pdfarranger</projectUrl>
    <projectSourceUrl>https://github.com/pdfarranger/pdfarranger</projectSourceUrl>
    <packageSourceUrl>https://github.com/hoanganhduc/chocolatey/tree/master/pdfarranger</packageSourceUrl>
    <releaseNotes>https://github.com/pdfarranger/pdfarranger/releases/tag/1.13.0</releaseNotes>
    <tags>pdfarranger pdf merge split rotate crop rearrange gui</tags>
    <licenseUrl>https://raw.githubusercontent.com/pdfarranger/pdfarranger/main/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
